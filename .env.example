DATABASE_URL=postgresql+psycopg://regtrack:regtrack@localhost:5432/regtrack
STORAGE_DIR=                                              # write-once originals, sha256-named (empty = <project>\data\raw)
SEED_CORPUS_DIR=D:\Regulatory_Documents                   # READ-ONLY seed corpus (2,274 files); optional - only for import-seed
LLM_BASE_URL=https://<ngrok-id>.ngrok-free.app/v1         # changes when ngrok restarts
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=lm-studio
EMBED_MODEL=<embedding model loaded in LM Studio>
EMBED_DIM=768                                             # must match vector(N) in the migration
STORAGE_BACKEND=local                                     # local | s3 (MinIO: docker compose --profile s3 up -d minio)
S3_ENDPOINT=localhost:9000
S3_BUCKET=regtrack-raw
S3_ACCESS_KEY=regtrack
S3_SECRET_KEY=regtrack-minio-secret
S3_SECURE=false
REGTRACK_COUNTRY=IN                                       # IN | TH: which country's sources, files and documents this install works on
PG_BIN=                                                   # local PostgreSQL programs folder (README: without Docker); empty = Docker
PG_DATA=                                                  # local PostgreSQL data folder (initdb -D)
IMPORT_DIR=D:\regulatory_intelligence\data\import       # hand-saved documents: <IMPORT_DIR>\TH\..., <IMPORT_DIR>\MY\... (read-only)
TESSERACT_CMD=D:\tesseract\Library\bin\tesseract.exe        # Thai OCR: Tesseract 5 from conda-forge (README)
TESSDATA_PREFIX=D:\tesseract\Library\share\tessdata     # its tha + eng .traineddata
EMBED_SCOPE=priority                                      # all | priority (current, in-scope chunks only: metered tunnels)
LLM_REASONING_EFFORT=none                                 # Qwen3 'thinking' off per request (structured output); empty = server default
